def standardise_features(X_train):

  '''
  Args:
      X_train: Training dataset
  Returns:
      X_train (After Standardization)
  Notes:
      1. Please do not change the provided code
  '''

  # STUDENT TODO START:
  col = X_train.shape[1]
  for i in range(col):
    feature = X_train[:,i]
    u = np.mean(feature)
    s = np.std(feature)
    feature = (feature - u) / s
    X_train[:,i] -= u
    X_train[:,i] /= s
    
  # STUDENT TODO END
  return X_train
